{
  "apiVersion": "egress-intent.kubeswift.io/v1",
  "kind": "EgressIntent",
  "owner": {"namespace": "team-a", "kind": "SwiftSandboxPool", "name": "agents"},
  "listeners": {"transparent": 15006},
  "allow": [
    {"host": "api.example.com", "ports": [{"port": 443, "protocol": "TCP"}], "from": "host api.example.com"},
    {"host": "*.example.org", "from": "host *.example.org"}
  ],
  "credentials": [
    {"name": "API_KEY", "placeholder": "ks-0123456789abcdef0123456789abcdef",
     "destinations": ["api.example.com:443", "models.example.org:443"], "header": "Authorization", "valueTemplate": "Bearer {}",
     "file": "/run/kubeswift/egress/secrets/cred-API_KEY", "headerValueFile": "/run/kubeswift/egress/secrets/header-API_KEY"},
    {"name": "ORG_ID", "placeholder": "ks-fedcba9876543210fedcba9876543210",
     "destinations": ["api.example.com:443"], "header": "X-Org-Id", "valueTemplate": "{}",
     "file": "/run/kubeswift/egress/secrets/cred-ORG_ID"}
  ],
  "tls": {"interceptCA": {"cert": "/run/kubeswift/egress/secrets/ca.crt"},
          "certificates": [
            {"hosts": ["api.example.com"], "cert": "/run/kubeswift/egress/secrets/cert-0.crt", "key": "/run/kubeswift/egress/secrets/cert-0.key"},
            {"hosts": ["models.example.org"], "cert": "/run/kubeswift/egress/secrets/cert-1.crt", "key": "/run/kubeswift/egress/secrets/cert-1.key"}
          ]},
  "secretsDir": "/run/kubeswift/egress/secrets"
}
