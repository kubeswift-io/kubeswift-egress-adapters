{
  "envoy.json": {
    "admin": {
      "address": {
        "socket_address": {
          "address": "127.0.0.1",
          "port_value": 15000
        }
      }
    },
    "node": {
      "cluster": "kubeswift-egress",
      "id": "kubeswift-sandbox"
